#!/usr/bin/with-contenv bash

# ==========================================
# 🤖 Openbox Container Initialization Script
# ==========================================

# 1. 뼈대(skel) 파일 복사 (마운트 볼륨 내에 존재하지 않는 경우에만)
echo "[Init] Syncing default skel configurations to /config"
cp -rn /opt/skel/. /config/

# 2. oh-my-zsh 미설치 시 자동 설치
if [ ! -d "/config/.oh-my-zsh" ]; then
    echo "[Init] Installing oh-my-zsh for abc user"
    sudo -u abc sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi

# 3. menu.xml 내의 프로젝트 경로를 컨테이너 환경변수로 치환
REAL_PATH="${PROJECT_PATH:-/config}"
echo "[Init] Setting OpenCode Desktop workspace target to: ${REAL_PATH}"
sed -i "s|__PROJECT_PATH__|${REAL_PATH}|g" /config/.config/openbox/menu.xml

# 4. 소유권 정리 (볼륨 마운트 권한 보장)
chown -R abc:abc /config
