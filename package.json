{
  "name": "scraper-root",
  "version": "1.0.0",
  "description": "Development Root Workspace for LinkedIn Clipper Project",
  "private": true,
  "workspaces": [
    "apps/agents",
    "apps/crawler",
    "apps/viewer",
    "apps/wiki"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint:crawler": "npm run lint --prefix apps/crawler",
    "lint:viewer": "npm run lint --prefix apps/viewer",
    "lint:ebook": "cd apps/ebook && .venv/bin/python -m poethepoet lint",
    "lint:wiki": "cd apps/wiki && uv run ruff check src/worker/ src/web/",
    "lint": "npm run lint:crawler && npm run lint:viewer && npm run lint:ebook && npm run lint:wiki",
    "format:crawler": "npm run format --prefix apps/crawler",
    "format:viewer": "npm run format --prefix apps/viewer",
    "format:ebook": "cd apps/ebook && .venv/bin/python -m poethepoet format",
    "format": "npm run format:crawler && npm run format:viewer && npm run format:ebook",
    "type-check:wiki": "cd apps/wiki && uv run mypy src/worker/ src/web/",
    "type-check:crawler": "npm run type-check --prefix apps/crawler",
    "type-check:viewer": "npm run type-check --prefix apps/viewer",
    "type-check:ebook": "cd apps/ebook && .venv/bin/python -m poethepoet type-check",
    "type-check": "npm run type-check:crawler && npm run type-check:viewer && npm run type-check:ebook && npm run type-check:wiki",
    "review": "ts-node apps/agents/src/review-changes.ts",
    "gitea": "NODE_OPTIONS=\"--use-system-ca\" ts-node apps/agents/src/gitea.ts",
    "gitea:token": "NODE_OPTIONS=\"--use-system-ca\" npm run gitea generate-token",
    "gitea:token:tea": "NODE_OPTIONS=\"--use-system-ca\" npm run gitea generate-token-tea",
    "commit": "NODE_OPTIONS=\"--use-system-ca\" ts-node apps/agents/src/commit-changes.ts",
    "push": "NODE_OPTIONS=\"--use-system-ca\" ts-node apps/agents/src/push-changes.ts",
    "agents:sessions": "ts-node --project apps/agents/tsconfig.json apps/agents/src/sessions.ts",
    "agents:rules": "ts-node --project apps/agents/tsconfig.json apps/agents/src/rules.ts",
    "agents:usage": "ts-node --project apps/agents/tsconfig.json apps/agents/src/usage.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
